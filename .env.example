# ── Mock API (기본) ──
VITE_USE_MOCK=true

# API 서버 URL (설정 시 mock 대신 실제 API 사용)
# VITE_API_BASE_URL=http://localhost:3000

# ── 챗봇 LLM ──
# rule: 규칙 기반 (기본) | llm: OpenAI 등 LLM 사용
VITE_CHAT_PROVIDER=llm

# OpenAI API (Vite dev/preview 서버에서 /api/chat/completions 처리)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── 사랑기사 분석·채점 백엔드 (SSD_Scoring, FastAPI) ──
# 개발 모드(npm run dev)는 비워 두면 Vite 프록시(/api/v1 → http://127.0.0.1:8000)를 사용합니다.
# 정적 배포(Vercel 등)에서는 실제 백엔드 주소를 넣어야 합니다.
# VITE_SCORING_API_BASE_URL=http://127.0.0.1:8000

# ── 기사·호수·통계 데이터 출처 ──
# db(기본): 분석 서버 PostgreSQL에서 읽음 — 다른 컴퓨터와 공유됨
# mock: 예전 데모(Mock) 데이터로 되돌리기
# VITE_ARTICLES_SOURCE=mock
