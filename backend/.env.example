OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# OpenAI 요청 1건의 최대 대기 시간(초). 응답이 멈춘 요청은 끊고 재시도한다.
OPENAI_TIMEOUT_SECONDS=120

# 동시에 처리할 페이지 수(기사 추출)와 기사 수(점수화).
# Tier 1 키 기준 6/8이 안정적. Tier 2 이상이면 20/25까지 올려도 된다.
EXTRACTION_CONCURRENCY=6
SCORING_CONCURRENCY=8

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 프론트에서 업로드한 파일 저장 위치(상대경로는 프로젝트 루트 기준)
UPLOAD_DIR=storage/uploads
CLIPPED_DIR=storage/clipped

# 업로드 제한
MAX_UPLOAD_MB=150
MAX_PDF_PAGES=400
PDF_RENDER_DPI=200

# 프론트 개발 서버 주소. 여러 개면 쉼표로 구분
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# false이면 추출 작업 종료 후 업로드 원본 PDF 삭제
KEEP_UPLOADED_FILES=true

# (선택) 프론트 빌드 폴더(BREDRED_simplified/dist). 지정하면 서버 하나로 화면까지 서빙
# FRONTEND_DIST=C:/Users/USER/BREDRED_simplified/dist

# (선택) 접속 토큰 — 설정 시 /api 요청에 X-Access-Token 헤더 필요 (LAN 공유 시 권장)
# API_ACCESS_TOKEN=우리팀만아는암호


# ── 사람 손을 덜 타게 하는 옵션 (둘 다 기본은 꺼짐) ──
# 채점이 끝나면 AI가 확실하게 확정하는 건(4번·5번·점수제외, 경고 없음)을 자동 확정한다.
# 1번·2번·기타 유형과 추출 경고가 있는 건은 그대로 사람이 검수한다.
# AUTO_CONFIRM_AFTER_SCORING=1
# 검수자가 고친 점수를 다음 채점의 참고 사례(이름 · 부서 제외)로 함께 보낸다.
# SCORING_USE_FEEDBACK=1
